<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:label="Leumadepos"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!-- singleTop (Flutter's own default) only dedupes an intent
             within the SAME task — it does nothing to stop a NEW task
             (and therefore a whole new FlutterEngine/Dart isolate, with
             fresh in-memory state) from being spun up when the App Links
             email-sign-in link is tapped from a different app (Gmail)
             while this app already has an existing, merely-backgrounded
             task. That silently defeated the shared-tablet handoff guard
             in FirebaseAuthRepository (it read _currentUser off the
             wrong, brand-new instance). singleTask guarantees the OS
             reuses/foregrounds the existing task and delivers the new
             intent via onNewIntent instead — confirmed via
             `dumpsys activity activities` showing two live tasks before
             this change, one after. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Routes the email-link sign-in link back into the app.
                 Firebase Dynamic Links (the old routing mechanism) shut
                 down Aug 25, 2025 — this is the current replacement: the
                 project's default Firebase Hosting domain, per
                 https://firebase.google.com/docs/auth/android/email-link-migration.
                 android:host must match the project's actual default
                 Hosting domain (lpos-ac40b.firebaseapp.com) — if the
                 Firebase project ID ever changes, this has to change too. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data
                    android:scheme="https"
                    android:host="lpos-ac40b.firebaseapp.com"
                    android:pathPrefix="/__/auth/links"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
