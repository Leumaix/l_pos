rules_version = '2';

// Leumadepos — Firestore security rules.
//
// Tenant isolation is structural: every business's data lives under
// businesses/{businessId}/..., and isActiveStaffOf() is the ONE gate that
// decides who can read or write anything in that subtree. It is not a
// convention the client is trusted to follow — every rule below calls it
// directly, so a request the client never intended (a bug, a modified
// build, a raw REST/SDK call bypassing the app entirely) is bound by the
// exact same check as the real app.
//
// What this does NOT do: validate the CONTENT of a write (e.g. that a
// sale's total actually matches its line items, or that a stock delta is
// internally consistent). That's enforced by the app's own transaction
// logic (CheckoutController et al.), not by these rules — there is no
// Cloud Functions layer on Spark to re-derive and check that server-side.
// The boundary these rules enforce is WHO can write to a business's data
// (an active staff member of THAT business, no one else, ever
// unauthenticated) — not a guarantee that every write is well-formed.
// Accepted for MVP: staff are trusted employees of a single small
// business, not the general public.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // The actual access gate: signed in, AND a staff doc for this UID
    // exists under this specific business, AND it's marked active. Every
    // rule below calls this directly rather than assuming the client only
    // ever requests its own business's path.
    function isActiveStaffOf(businessId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/businesses/$(businessId)/staff/$(request.auth.uid))
        && get(/databases/$(database)/documents/businesses/$(businessId)/staff/$(request.auth.uid)).data.active == true;
    }

    // An active staff member whose role is specifically 'owner' — the
    // one role trusted to provision other staff in-app (see /invites and
    // /staff's allow-create below). This only ever governs who can add
    // STAFF to a business that ALREADY EXISTS; it says nothing about
    // creating the business itself — see isPlatformSuperAdmin() below for
    // that.
    function isActiveOwnerOf(businessId) {
      return isActiveStaffOf(businessId)
        && get(/databases/$(database)/documents/businesses/$(businessId)/staff/$(request.auth.uid)).data.role == 'owner';
    }

    // The platform operator (Sammy), not tied to any one business — used
    // by the separate super-admin onboarding tool to create new
    // businesses and their first-owner invite, and to read across every
    // business for monitoring. Membership is a Firestore document
    // (platformConfig/superAdmins.uids, a plain list), not a uid literal
    // baked into this file, so granting/revoking admin access later is a
    // database write, not a rules edit + redeploy — same shape as
    // isActiveOwnerOf's own staff-membership check, one level up. That
    // document itself is unreadable and unwritable from any client (see
    // its own match block below) — this get() still works regardless,
    // since a rule's own internal get()/exists() calls are exempt from
    // the target document's rules, exactly how isActiveStaffOf already
    // reads staff/{uid} regardless of THAT document's own allow read.
    // Bootstrapping the first entry (and changing membership later) is a
    // deliberate, one-time, out-of-band Console/Admin-SDK action — the
    // same shape as the very first business owner's own bootstrap.
    function isPlatformSuperAdmin() {
      return isSignedIn()
        && request.auth.uid in get(/databases/$(database)/documents/platformConfig/superAdmins).data.uids;
    }

    // Used only by shiftState/current's delete rule (closing a shift) —
    // a delete has no request.resource.data to carry a pointer to the
    // paired shiftHistory record the way an update can, so the pointer
    // (plannedHistoryId) and the values to check it against are passed
    // in explicitly from resource.data (the doc's state before deletion).
    // One getAfter() call, reused via `let`, rather than two identical
    // calls inline.
    function shiftCloseIsPaired(businessId, plannedHistoryId, openingFloatNaira, cashTotalNaira) {
      let historyDoc = getAfter(/databases/$(database)/documents/businesses/$(businessId)/shiftHistory/$(plannedHistoryId));
      return historyDoc.data.closedAt is timestamp
        && historyDoc.data.expectedCashNaira == openingFloatNaira + cashTotalNaira;
    }

    // Platform-operator config, not scoped to any business. Deliberately
    // unreadable and unwritable from any client, even a recognized
    // super-admin — see isPlatformSuperAdmin()'s own comment for why its
    // internal get() still works regardless. The only way this document
    // is ever created or changed is Console/Admin SDK, out-of-band.
    match /platformConfig/{docId} {
      allow read, write: if false;
    }

    match /businesses/{businessId} {
      // Business settings (name, tank capacity): readable by active
      // staff, or the platform super-admin monitoring across every
      // business. Writable only in one narrow way: an active owner may
      // update settings.gasTankCapacityKg — nothing else on this
      // document, ever, from the client, not even the super-admin (see
      // allow update below — no isPlatformSuperAdmin() carve-out there,
      // deliberately). That field only feeds the Stock screen's gauge,
      // so it's safe to open up on its own. The gas RATE is a separate,
      // owner-only editable field — but it lives on gasStock/current
      // (below), not here, since changing it has to atomically recompute
      // units too; see that match block.
      allow read: if isActiveStaffOf(businessId) || isPlatformSuperAdmin();
      allow update: if isActiveOwnerOf(businessId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['settings'])
        && (
          !('settings' in resource.data)
          || request.resource.data.settings.diff(resource.data.settings).affectedKeys().hasOnly(['gasTankCapacityKg'])
        );

      // Creating a brand-new business is the one thing ONLY the
      // super-admin onboarding tool can do — no owner of any business,
      // including this one, can ever create another. Deletion stays
      // hard-denied for everyone; not a capability this app offers.
      allow create: if isPlatformSuperAdmin();
      allow delete: if false;

      match /staff/{staffId} {
        // A staff member reads only their OWN doc, never the roster —
        // nothing in the app needs the full staff list, and phone/email
        // on a colleague's record isn't this client's business. The
        // super-admin tool is the one exception, reading across every
        // business's roster for monitoring.
        allow read: if (isSignedIn() && request.auth.uid == staffId) || isPlatformSuperAdmin();

        // Self-service provisioning: lets an owner add staff in-app (see
        // /invites below) without touching the console — business
        // creation itself stays console-only, this is only about adding
        // staff to a business that already exists. A signed-in user may
        // create ONLY their own staff doc (their uid, not anyone else's),
        // ONLY if a real, owner-issued invite exists for their auth
        // email under THIS business, and ONLY with the exact role that
        // invite specifies — the role is never taken from the client's
        // own write, it's cross-checked against the invite server-side,
        // so nobody can grant themselves "owner" (or any role) that
        // wasn't already decided by an existing owner. email_verified is
        // redundant in practice (email-link sign-in always sets it) but
        // cheap, explicit insurance that this is gated on PROVEN email
        // ownership, not just any signed-in uid.
        allow create: if isSignedIn()
          && request.auth.token.email_verified == true
          && request.resource.id == request.auth.uid
          && exists(/databases/$(database)/documents/businesses/$(businessId)/invites/$(request.auth.token.email.lower()))
          && request.resource.data.role == get(/databases/$(database)/documents/businesses/$(businessId)/invites/$(request.auth.token.email.lower())).data.role;

        // Everything else about /staff stays console-only, exactly as
        // before: no client update or delete, ever.
        allow update, delete: if false;
      }

      match /invites/{email} {
        // Who can ISSUE a staff invite: an active owner of THIS
        // business — the in-app on-ramp is gated exactly as tightly as
        // console provisioning was — OR the platform super-admin, which
        // exists specifically for the brand-new-business case: a
        // business with no owner yet has no staff doc for anyone, so
        // isActiveOwnerOf can never be true for it, no matter who's
        // asking. The super-admin onboarding tool's first-owner invite
        // relies on exactly this carve-out. No update path: a changed
        // invite is a delete-then-create (see the client), so there's
        // never an ambiguous partial edit to reason about.
        allow create: if isActiveOwnerOf(businessId) || isPlatformSuperAdmin();

        // Who can DELETE one: an active owner revoking a pending invite
        // (the account-menu UI), OR the invited person themselves,
        // consuming their OWN matching invite as the second half of the
        // atomic self-provisioning batch in /staff's create rule below
        // (FirebaseAuthRepository._loadStaffDoc: staff-doc create +
        // invite delete, committed together). If this were owner-only,
        // that batch could never succeed for a brand-new self-service
        // attendant or owner — they have no staff doc yet at the moment
        // of that delete, so isActiveOwnerOf is always false for them,
        // and the whole atomic write fails, taking the otherwise-valid
        // staff-doc creation down with it. This went undetected because
        // the very first owner on this project was bootstrapped by hand
        // in the console instead, never exercising invite consumption
        // at all until a second real invite was tested. Self-deleting
        // your own invite without ever completing the matching staff
        // doc is harmless — it only forfeits your own pending invite,
        // never grants access to anything.
        allow delete: if isActiveOwnerOf(businessId)
          || (isSignedIn() && request.auth.token.email.lower() == email);

        allow update: if false;

        // Read access is deliberately narrower than write: an owner can
        // read any invite (to list/manage pending ones), but anyone else
        // signed in can read ONLY the single invite that matches their
        // OWN auth email — never the whole collection. This is what
        // lets the client read the name/role it needs to write into its
        // own staff-doc creation above, without exposing who else has
        // been invited. The super-admin tool can read any invite, on any
        // business, for monitoring.
        allow read: if isActiveOwnerOf(businessId)
          || (isSignedIn() && request.auth.token.email.lower() == email)
          || isPlatformSuperAdmin();
      }

      match /gasStock/{docId} {
        allow read: if isActiveStaffOf(businessId) || isPlatformSuperAdmin();

        // Two deliberately separate create paths, mirroring the two
        // update paths below — a create can't use .diff(resource.data)
        // the way an update does (resource doesn't exist yet), so each
        // is scoped via request.resource.data.keys() instead.
        //
        // 1. First-write provisioning by an ordinary sale/restock delta
        //    — matches status quo (addGasStock/deductGasStock use a
        //    merge-set, which needs create allowed for the very first
        //    write before the doc exists). Touches ONLY `units`, same
        //    scoping as the ordinary-duty update rule below.
        allow create: if isActiveStaffOf(businessId)
          && request.resource.data.keys().hasOnly(['units']);

        // 2. First-ever rate set on a business that's never had one —
        //    owner-only, mirroring the owner-only rate-CHANGE update
        //    rule below (see FirebaseInventoryRepository.changeGasRate's
        //    'initialize' branch). There's no old rate to preserve
        //    physical kg against here, so units must be exactly 0 — a
        //    fresh initialization, not a recompute.
        allow create: if isActiveOwnerOf(businessId)
          && request.resource.data.keys().hasOnly(['rate', 'units'])
          && request.resource.data.rate is number
          && request.resource.data.rate > 0
          && request.resource.data.units == 0;

        // Two deliberately separate update paths now that `rate` lives on
        // this same doc — a single "any active staff can write anything"
        // rule (what this used to be) would let an ordinary attendant set
        // {rate: anything, units: anything} together with no consistency
        // check at all, which is a much bigger hole than the owner-only
        // risk this is actually guarding against.
        //
        // 1. Ordinary staff duty — a sale or restock delta. Touches ONLY
        //    `units` (via FieldValue.increment); `rate` is never part of
        //    this write. Any active staff member, same access as before
        //    this field split.
        allow update: if isActiveStaffOf(businessId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['units']);

        // 2. Owner-only rate change. Touches `rate` AND `units` together
        //    in the same write, and the units value must represent the
        //    SAME physical kg the old units did, just re-expressed at the
        //    new rate — not just "the owner can write any {rate, units}
        //    pair", which would make "changing the rate" a backdoor to
        //    silently inflate or deflate stock outside the normal
        //    restock/sale trail. The ±0.01kg band absorbs the rounding
        //    from gas_stock's changeRate()/unitsForKg() (round-to-nearest-
        //    unit — a fraction of a naira), nothing more.
        allow update: if isActiveOwnerOf(businessId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rate', 'units'])
          && request.resource.data.rate is number
          && request.resource.data.rate > 0
          && float(resource.data.units) / float(resource.data.rate)
             <= float(request.resource.data.units) / float(request.resource.data.rate) + 0.01
          && float(resource.data.units) / float(resource.data.rate)
             >= float(request.resource.data.units) / float(request.resource.data.rate) - 0.01;

        // 3. Owner sets a rate for the first time on a doc that already
        //    EXISTS with units but no rate — distinct from create rule 2
        //    above (which only ever applies before the doc exists at
        //    all). Ordinary staff sales/restock activity (create rule 1)
        //    can produce exactly this state — units recorded before any
        //    owner ever visited Settings — and every one of those units
        //    was computed client-side using kDefaultGasRateNairaPerKg
        //    (lib/core/business_config.dart), the fallback rate the app
        //    uses whenever this doc has no `rate` yet. This preserves
        //    physical kg from THAT implicit rate, exactly like rule 2
        //    does from an explicit one — see
        //    FirebaseInventoryRepository.changeGasRate's matching
        //    client-side branch. The 1400 literal below is
        //    kDefaultGasRateNairaPerKg's value, copied by hand: rules
        //    have no way to reference a Dart constant, so if that
        //    constant ever changes, this must change with it.
        allow update: if isActiveOwnerOf(businessId)
          && !('rate' in resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rate', 'units'])
          && request.resource.data.rate is number
          && request.resource.data.rate > 0
          && float(resource.data.units) / 1400.0
             <= float(request.resource.data.units) / float(request.resource.data.rate) + 0.01
          && float(resource.data.units) / 1400.0
             >= float(request.resource.data.units) / float(request.resource.data.rate) - 0.01;

        // No legitimate reason to ever delete the current stock doc.
        allow delete: if false;
      }

      match /gasStockLedger/{entryId} {
        // Append-only audit trail — created by a sale or a restock,
        // never edited or removed after the fact.
        allow read: if isActiveStaffOf(businessId) || isPlatformSuperAdmin();
        allow create: if isActiveStaffOf(businessId);
        allow update, delete: if false;
      }

      match /categories/{categoryId} {
        // Owner-managed catalog: only an active owner can create, rename,
        // reorder (an update touching sortOrder), or delete a category.
        // Deleting a category that still has products in it is blocked
        // client-side, not here — rules can't query "does any product
        // reference this category", only check specific known document
        // paths (see FirebaseInventoryRepository.deleteCategory).
        allow read: if isActiveStaffOf(businessId) || isPlatformSuperAdmin();
        allow create, update, delete: if isActiveOwnerOf(businessId);
      }

      match /products/{productId} {
        allow read: if isActiveStaffOf(businessId) || isPlatformSuperAdmin();

        // Owners can do anything to a product — rename, reprice, move it
        // to a different category, or remove it entirely.
        allow create, delete: if isActiveOwnerOf(businessId);

        // A regular active staff member can still sell (which decrements
        // stockCount) and restock (which increments it) — that's the one
        // field they're allowed to move. They can't create or delete a
        // product, and an update touching anything else (name, price,
        // categoryId, unit) is denied even for them, so a staff member
        // can never silently reprice or rename the catalog while ringing
        // up a sale.
        //
        // stockCount >= 0 applies regardless of who's writing — unlike
        // gas (a running balance that's allowed to dip negative as a
        // reconciliation signal, by design), a product is a discrete,
        // physically countable thing; a negative count is never
        // meaningful. This is what actually stops the real-world race
        // this guards against: two staff each sell the last unit before
        // either checkout commits — each sale is its own atomic
        // transaction, but the two transactions aren't atomic with each
        // other, so without this, a second FieldValue.increment(-1)
        // could still land after the first already sold the last one.
        allow update: if request.resource.data.stockCount >= 0
          && (
            isActiveOwnerOf(businessId)
            || (
              isActiveStaffOf(businessId)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stockCount'])
            )
          );
      }

      match /customers/{customerId} {
        allow read: if isActiveStaffOf(businessId) || isPlatformSuperAdmin();

        // A brand-new customer can only start at a nonzero balance if
        // an owner is creating it (migrating an existing debtor's
        // opening balance — see Customers screen). Any active staff
        // member can still add a walk-in at the zero balance every new
        // customer normally starts at.
        allow create: if isActiveStaffOf(businessId)
          && (isActiveOwnerOf(businessId) || request.resource.data.balance == 0);

        // An owner can freely rename/re-phone/adjust a customer. A
        // staff member's update is scoped tighter than just "touches
        // balance": lastTransactionId must point at a transactions/
        // doc that ALSO gets created in this exact same write (see
        // FirebaseCustomerRepository/FirebaseCheckoutRepository — both
        // use one runTransaction for the pair), and getAfter() checks
        // that doc's balanceAfter matches the new balance being
        // written here. Without this, "isActiveStaffOf" alone would
        // let a staff member move balance to any number with a single
        // bare update — bypassing recordCreditSale/recordRepayment
        // entirely and leaving no trace. This doesn't independently
        // verify the ledger entry's own amountNaira/type arithmetic
        // (rules can't reach into a related collection's history to
        // recompute a running total) — but it does mean any balance
        // change is now permanently paired with a real, staff-
        // attributed, append-only record carrying the exact number
        // written, not silent.
        allow update: if isActiveOwnerOf(businessId)
          || (
            isActiveStaffOf(businessId)
            && (
              !('balance' in request.resource.data.diff(resource.data).affectedKeys())
              || (
                request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance', 'lastTransactionId'])
                && request.resource.data.balance ==
                   getAfter(/databases/$(database)/documents/businesses/$(businessId)/customers/$(customerId)/transactions/$(request.resource.data.lastTransactionId)).data.balanceAfter
              )
            )
          );

        // No delete path — never exercised by the app (no
        // deleteCustomer method exists), and removing a customer
        // record isn't a routine staff action even if it were built
        // later; tightened here from the blanket rule this replaced.

        match /transactions/{transactionId} {
          // Append-only ledger — a correction is a new transaction, not
          // an edit to history.
          allow read: if isActiveStaffOf(businessId) || isPlatformSuperAdmin();
          allow create: if isActiveStaffOf(businessId);
          allow update, delete: if false;
        }
      }

      match /sales/{saleId} {
        // A sale is immutable once recorded — no update/delete path at
        // all, from anyone, ever.
        //
        // Read is owner-only: this is the collection Reports and Home's
        // "Today's sales" aggregate from, and revenue is business-wide
        // financial data an attendant isn't shown by design (see Home's
        // role split). That boundary has to be enforced here, not just
        // by the client never asking — an attendant's own authenticated
        // session could otherwise query this collection directly and
        // get full revenue regardless of what the UI shows. Create stays
        // open to any active staff member: checking out a customer
        // writes a sale, but the receipt screen shows the Sale object
        // it's handed in memory, never reads this collection back — no
        // attendant-facing screen needs read access at all.
        //
        // The exists() check is the real, server-side enforcement of
        // "no ringing up a sale before the day is opened" — see
        // shiftState/current below. CheckoutController/
        // FirebaseCheckoutRepository check this too, for a clean client-
        // side error instead of a raw permission-denied, but this is
        // what actually can't be bypassed.
        allow read: if isActiveOwnerOf(businessId) || isPlatformSuperAdmin();
        allow create: if isActiveStaffOf(businessId)
          && exists(/databases/$(database)/documents/businesses/$(businessId)/shiftState/current);
        allow update, delete: if false;
      }

      match /shiftState/{docId} {
        // A business day's cash-drawer tracking, scoped to the whole
        // business (not per staff member) — opened once, closed once,
        // regardless of how many staff hand the shared tablet off to
        // each other in between. Any active staff member can open or
        // close, matching how selling/restocking gas is an ordinary
        // staff duty, not owner-only.
        //
        // Existence IS "a shift is open" — no separate status field.
        // That's what /sales create's exists() check above relies on,
        // and it's also what makes "block opening a new day until the
        // stale one is closed" fall out of Firestore's own create-vs-
        // update classification for free: `allow create` below only
        // ever matches a write against a doc that doesn't already exist,
        // so a second open attempt while one is live has no matching
        // rule at all — no separate staleness check needed.
        allow read: if isActiveStaffOf(businessId) || isPlatformSuperAdmin();
        allow create: if isActiveStaffOf(businessId)
          && request.resource.data.openingFloatNaira is number
          && request.resource.data.openingFloatNaira >= 0;

        // Sale-time totals increment ONLY — never openingFloat/openedBy/
        // plannedHistoryId/etc. This is the one write
        // FirebaseCheckoutRepository.commitSale performs mid-transaction.
        allow update: if isActiveStaffOf(businessId)
          && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['cashTotalNaira', 'cardTotalNaira', 'transferTotalNaira', 'creditTotalNaira', 'salesCount']);

        // Closing a shift deletes this doc — the ONLY way "a shift is
        // open" ever becomes false again. This is a real data-loss risk
        // done wrong (the whole day's running totals gone with nothing
        // to reconstruct), unlike the gas-stock/product-delta boundary
        // this file otherwise draws — so unlike those, this doesn't just
        // trust the client to pair the delete with an honest archive.
        //
        // A delete has no request.resource.data (no resulting document)
        // to carry a pointer to the paired shiftHistory doc the way an
        // update can — see /customers' lastTransactionId pattern above.
        // So the pointer has to already be sitting on the doc being
        // deleted: plannedHistoryId, minted and written at open time
        // (see FirebaseShiftRepository.openDay). getAfter() then checks
        // that EXACT id actually gained a real closed-shift record, in
        // this same transaction — not just that some doc somewhere in
        // shiftHistory was created. And since openingFloatNaira/
        // cashTotalNaira are sitting right here on resource.data (no
        // unrelated-collection history to recompute, unlike gas/product
        // deltas), this also checks the archived record's expectedCash
        // is arithmetically honest, not fabricated — countedCashNaira/
        // varianceNaira are left unverified, same trust boundary as any
        // ledger amountNaira (only the person who counted the drawer
        // knows that number).
        allow delete: if isActiveStaffOf(businessId)
          && shiftCloseIsPaired(
               businessId,
               resource.data.plannedHistoryId,
               resource.data.openingFloatNaira,
               resource.data.cashTotalNaira
             );
      }

      match /shiftHistory/{shiftId} {
        // Append-only archive of closed shifts. Read is owner-only —
        // same boundary as /sales: per-method totals for a whole
        // business day is exactly the kind of revenue figure Home's
        // role split already keeps from attendants, even though any
        // staff member can be the one who CLOSES a shift (create).
        allow read: if isActiveOwnerOf(businessId) || isPlatformSuperAdmin();
        allow create: if isActiveStaffOf(businessId);
        allow update, delete: if false;
      }
    }

    // Nothing else exists at the top level besides platformConfig (its
    // own match block above, unconditionally locked to every client).
    // Creating a BUSINESS document is now possible for exactly one
    // identity — the platform super-admin, via isPlatformSuperAdmin()'s
    // carve-out on /businesses/{businessId}'s own allow create above —
    // everyone else, including every business's own owner, still has no
    // path to it at all. Adding STAFF to a business that already exists
    // remains the one thing an ordinary owner can do in-app, through the
    // narrow, invite-gated path above; the super-admin's own invite
    // carve-out exists solely to unblock a business's very FIRST owner,
    // before any staff doc exists for anyone to be "active owner" of.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
