# Node (firestore_rules_tests' emulator test harness)
**/node_modules/

# Flutter/Dart
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.packages
**/build/

# pubspec.lock: commit it for the app (reproducible builds), not for
# library packages (best practice for packages meant to be depended on).
/packages/**/pubspec.lock

# Android
**/android/.gradle/
**/android/local.properties
**/android/key.properties
**/*.jks
**/*.keystore

# iOS
**/ios/Pods/
**/ios/Flutter/ephemeral/
**/ios/.symlinks/
**/*.xcworkspace/xcuserdata/

# IDE
.idea/
.vscode/
*.iml

# Firebase (secrets — never commit)
**/google-services.json
**/GoogleService-Info.plist
**/firebase_options.dart
**/.firebaserc

# Firebase CLI local deploy-state cache — regenerated by `firebase
# deploy`, not something to version (churns per machine, no real content).
**/.firebase/

# Misc
.DS_Store
*.log
